# Celery Configuration (Task #12 - Gap #21)
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Production SQS (optional, future use)
# CELERY_BROKER_USE_SQS=false
# AWS_SQS_REGION=us-east-1

# Worker settings (optional, defaults in config.py)
# CELERY_WORKER_CONCURRENCY=2
# CELERY_WORKER_PREFETCH_MULTIPLIER=4

API_BASE_URL=https://your-tunnel.ngrok-free.dev
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx

# QuickBooks OAuth 2.0 (Task #16 - Gap #22)
QUICKBOOKS_CLIENT_ID=ABxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
QUICKBOOKS_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
QUICKBOOKS_REDIRECT_URI=https://your-tunnel.ngrok-free.dev/api/v1/integrations/quickbooks/callback
QUICKBOOKS_ENVIRONMENT=sandbox
ENCRYPTION_KEY=<generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())">

WHISPER_API_URL=http://localhost:8080/v1
WHISPER_MODEL=base
OLLAMA_API_URL=http://localhost:11434/api
OLLAMA_CHAT_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=mxbai-embed-large

# Test Endpoints Configuration (Gap #28)
# Enable unauthenticated /test endpoint variants for rapid development
# SECURITY: Only set to 'true' in dev/qa environments. NEVER in production.
TEST_ENDPOINT_ENABLED=true
ENVIRONMENT=dev
TEST_TENANT_ID=00000000-0000-0000-0000-000000000001
TEST_USER_ID=00000000-0000-0000-0000-000000000002

# MKT-B1-BE: Cloudflare Turnstile bot protection (server-side secret only — never in browser)
# Dev/test: Use always-passes test secret (no Cloudflare account needed)
# Production: Obtain from Cloudflare Dashboard → Turnstile → your site → Secret Key
CLOUDFLARE_TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# MKT-B1.5: HMAC secret for one-click newsletter unsubscribe tokens (32+ char random string)
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
NEWSLETTER_UNSUBSCRIBE_SECRET=dev-newsletter-unsub-secret-CHANGE-IN-PRODUCTION

# MKT-B1.5: Marketing site base URL (used to generate unsubscribe links)
MARKETING_SITE_BASE_URL=http://localhost:3001

# TEAM-INVITE-1: Web app base URL for invite link construction + QB callback redirect.
# Production: https://app.pilotfortrades.com
FRONTEND_URL=http://localhost:3000

# MKT-B6: Per-form notification routing
NEWSLETTER_EMAIL_ADDR=newsletter@pilotfortrades.com
SALES_EMAIL_ADDR=sales@pilotfortrades.com
CONTACT_US_EMAIL_ADDR=info@pilotfortrades.com
CAREERS_EMAIL_ADDR=careers@pilotfortrades.com
CAREERS_OPEN_ROLES=Example Role A,Example Role B

# Notification Services (Task #14 - Gap #26)
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxx
SENDGRID_FROM_EMAIL=noreply@pilotfortrades.com
SENDGRID_FROM_NAME=Pilot for Trades

# Map Provider Configuration (Task 1-C-1)
# "mock" uses haversine lat/lon math — safe for dev/CI (no quota usage)
# "google" requires a valid API key with Distance Matrix API enabled
MAP_PROVIDER=mock
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_API_URL=https://maps.googleapis.com/maps/api/distancematrix/json
MAP_HTTP_TIMEOUT_SECONDS=5.0
MAP_MOCK_FALLBACK_MINUTES=20

# C-B16: Tenant-hosted compliance sites base domain.
# Dev: localhost:3000 (wildcard *.localhost resolves on macOS).
# Prod: the registered domain (e.g. p4tsites.com).
TENANT_SITES_BASE_DOMAIN=localhost:3000

# ── SMS / Telnyx Integration (TELNYX-INT-1) ─────────────────────────────────
# SMS_CARRIER selects the carrier adapter: "mock" (in-memory, no network) |
# "telnyx" (real Telnyx API). Default "mock" is safe for local dev/CI.
SMS_CARRIER=mock
# Telnyx API key (Mission Control → API Keys). Only needed when SMS_CARRIER=telnyx.
TELNYX_API_KEY=
# Telnyx webhook public key (Ed25519, base64) for signature verification.
TELNYX_PUBLIC_KEY=
# Telnyx messaging profile ID for outbound send.
TELNYX_MESSAGING_PROFILE_ID=
# TELNYX-INT-1: When true, 10DLC brand/campaign creation uses Telnyx mock
# objects ($0 — no TCR fees, no SMS traffic). See 10DLC playbook §14.
# Only effective when SMS_CARRIER=telnyx. Default false.
TELNYX_10DLC_MOCK=false
# B21/FIND-173: sandbox FROM/TO numbers for live SMS integration tests.
TELNYX_SANDBOX_FROM_NUMBER=+15555551234
TELNYX_SANDBOX_TO_NUMBER=+15555551234

# Marketing Site — Cloudflare Turnstile (bot protection for waitlist form)
# Server-side secret key — never expose this in frontend code or commit to git
# Local dev: use always-passes test secret below (no real Cloudflare account needed)
# Production: use the secret key from dash.cloudflare.com > Turnstile > [site] > Secret Key
CLOUDFLARE_TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# ── Stripe Configuration ─────────────────────────────────────────────────────
# STRIPE_SECRET_KEY: Pilot's own subscription billing key (sk_test_... or sk_live_...)
# STRIPE_WEBHOOK_SECRET: Signing secret for the platform webhook endpoint
#   (Stripe Dashboard → Developers → Webhooks → https://api.pilotfortrades.com/api/v1/webhooks/stripe)
# See stripe-pricing-config.md §6 for local dev setup (ngrok test webhook URL).
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx

# STRIPE-CONNECT-1: Stripe Connect (Express) — tenant card payments
# STRIPE_CONNECT_PLATFORM_KEY: Connect API key (Account.create, Account.retrieve,
#   PaymentIntent with stripe_account=). In dev, falls back to STRIPE_SECRET_KEY
#   if unset (getattr fallback in stripe_connect.py / webhooks_stripe.py).
#   Sandbox: use the sandbox platform acct_XXXXXXXXXXXX secret key.
#   Prod: separate key or the same platform key (Tom's post-merge secrets step).
# STRIPE_CONNECT_WEBHOOK_SECRET: Signing secret for the Connect webhook endpoint
#   (Stripe Dashboard → Developers → Webhooks → Connect endpoint
#    https://api.pilotfortrades.com/api/v1/webhooks/stripe-connect → Signing secret).
#   This is SEPARATE from STRIPE_WEBHOOK_SECRET (the platform endpoint).
#   See stripe-pricing-config.md §8 for the Tom registration checklist.
STRIPE_CONNECT_PLATFORM_KEY=
STRIPE_CONNECT_WEBHOOK_SECRET=
