{
	"mcpServers": {
		"postgres-local": {
			"command": "npx",
			"args": [
				"-y",
				"@modelcontextprotocol/server-postgres",
				"postgresql://mcp_readonly:CHANGE_ME_READONLY_PW@localhost:5432/pilot_dev"
			],
			"alwaysAllow": [
				"query"
			],
			"disabled": false
		},
		"postgres-prod": {
			"command": "npx",
			"args": [
				"-y",
				"@modelcontextprotocol/server-postgres",
				"postgresql://mcp_readonly:CHANGE_ME_READONLY_PW@localhost:5433/pilot_prod?sslmode=no-verify"
			],
			"alwaysAllow": [
				"query"
			],
			"disabled": false
		},
		"redis": {
			"command": "npx",
			"args": [
				"-y",
				"@modelcontextprotocol/server-redis",
				"redis://localhost:6379"
			]
		}
	}
}