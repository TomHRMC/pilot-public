# OS Files
.DS_Store
Thumbs.db

# Workspace settings
.vscode/launch.json
.vscode/tasks.json
.idea/

# Logs
*.log

# Archived research and backup docs
archive/
*.bak

# Local Docker volumes and AI models
.local-data/

# Environment Variables (CRITICAL)
.env
.env.*
!.env.example
!**/.env.example
!**/.env.local.example

# Node
node_modules/

# ─── Terraform ────────────────────────────────────────────────────────────────
# terraform.tfvars contains the operator IP allowlist and environment config — never commit
infrastructure/terraform/environments/production/terraform.tfvars

# Terraform state files — state lives in S3 remote backend, never local
**/.terraform/
**/.terraform.lock.hcl
**/terraform.tfstate
**/terraform.tfstate.backup
**/terraform.tfstate.*.backup

# Terraform crash logs
crash.log
crash.*.log

# Terraform plan files (may contain sensitive values)
*.tfplan
*.tfplan.json

# Lambda deployment packages generated by Terraform archive_file
infrastructure/terraform/modules/security/post_confirmation.zip
infrastructure/terraform/modules/security/post_authentication.zip
infrastructure/terraform/modules/security/custom_email_sender.zip
# Lambda build dirs populated by build-*-lambda.sh (Linux wheels)
infrastructure/terraform/modules/security/build/

# Generated infrastructure state — run generate-infra-state.sh to regenerate
# Contains live AWS resource IDs — never commit
infrastructure/scripts/.infra-state.env
# Active profile state — written by profile scripts, read by profile-status.sh
# Contains current profile name and timestamp — never commit
infrastructure/scripts/.env.profiles

# Override files (local developer overrides — not for sharing)
override.tf
override.tf.json
*_override.tf
*_override.tf.json
# Agent instruction files - kept local, never published to the public repo
/AGENTS.md
/CLAUDE.md

# ─── Defensive rules for future commits ───────────────────────────────────────
# Python bytecode (admin-tools/ and scripts outside backend/)
__pycache__/
*.py[cod]

# Keys and certificates
*.pem
*.key
*.p12
*.p8
*.jks

# Terraform variables in any environment (examples allowed)
**/*.tfvars
**/*.tfvars.json
!**/*.tfvars.example

# Lambda deployment packages
infrastructure/terraform/modules/security/*.zip

# Test and tooling output
test-results/
playwright-report/
blob-report/
*.tsbuildinfo
.eslintcache

# Raw captures, audio and data dumps (removed for publication; keep them out)
*.eml
*.m4a
*.wav
*.mp3
*.sql.gz
*.dump

# Agent / editor workspaces
.claude/
.cursor/
*.code-workspace

# ─── Additional defensive rules (round 2) ─────────────────────────────────────
# Terraform state under any name
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info

# Python environments and tool caches (root backstop)
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Frontend build output and caches (root backstop)
.next/
.turbo/
.expo/
dist/
coverage/

# Live Stripe IDs wherever they land
**/stripe_ids.live.json

# More key / credential formats
*.pfx
*.crt
id_rsa*
*.kdbx

# Local databases and mobile build artifacts
*.sqlite
*.db
*.ipa
*.apk
*.aab
