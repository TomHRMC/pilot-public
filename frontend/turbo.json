{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"],
      "env": [
        "NEXT_PUBLIC_USE_MOCK_AUTH",
        "EXPO_PUBLIC_USE_MOCK_AUTH",
        "NEXT_PUBLIC_MOCK_USER_ROLE",
        "EXPO_PUBLIC_MOCK_USER_ROLE",
        "NEXT_PUBLIC_API_URL",
        "EXPO_PUBLIC_API_URL"
      ]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
