# Hoist all packages to the root node_modules directory (like npm/yarn classic).
#
# Required for Docker production builds (next build with Turbopack SSR):
# pnpm's virtual store creates separate symlink paths per package, which causes
# Turbopack's SSR worker to load two copies of React — one for apps/web and one
# for packages/ui. The result is a broken React context chain:
#   TypeError: (0 , c.useContext) is not a function
# because the NotificationQueueProvider context was created by React instance A
# but child components call useContext from React instance B.
#
# shamefully-hoist=true puts everything in root node_modules/, guaranteeing a
# single React instance. This is safe for a monorepo where all packages share
# the same React version.
#
# Note: --frozen-lockfile ignores public-hoist-pattern changes but DOES respect
# shamefully-hoist because it affects where existing resolved packages are placed.
shamefully-hoist=true
