# ============================================================
# Pilot for Trades — Marketing Site Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to source control.
# ============================================================

# Cloudflare Turnstile site key (public — safe to expose in browser JS)
# Get your key at: https://dash.cloudflare.com → Security → Turnstile → Add site
# For local dev: use the always-passes test key below (Cloudflare official)
# For production: use the key registered for pilotfortrades.com
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Backend API base URL (no trailing slash)
# Local dev: http://localhost:8000
# Production: https://api.pilotfortrades.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# Google Analytics 4 Measurement ID (add in MKT-B4)
# Format: G-XXXXXXXXXX
NEXT_PUBLIC_GA4_ID=

# Founding Member Program — slots remaining counter (update + redeploy to change)
# Default: 25 (full capacity). Decrement manually as slots fill (the program never launched).
NEXT_PUBLIC_FOUNDING_MEMBER_SLOTS_REMAINING=25
