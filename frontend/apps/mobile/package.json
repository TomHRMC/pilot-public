{
  "name": "mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "dev": "expo start",
    "build": "tsc --noEmit",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "jest --passWithNoTests --forceExit",
    "test:watch": "jest --watch"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "testPathIgnorePatterns": [
      "<rootDir>/e2e/"
    ],
    "transform": {
      "^.+\\.(js|jsx|ts|tsx|mjs)$": "babel-jest"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(\\.pnpm|(jest-)?react-native|@react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg|zustand|msw|rettime|until-async|@open-draft|@mswjs|@gluestack-ui|@pilot/.*|aws-amplify))"
    ],
    "moduleNameMapper": {
      "^@pilot/ui/(.*)$": "<rootDir>/../../packages/ui/src/$1",
      "^@pilot/ui$": "<rootDir>/../../packages/ui/src/index.ts",
      "^@pilot/shared-types$": "<rootDir>/../../packages/shared-types/src/api-schema.d.ts",
      "^react$": "<rootDir>/node_modules/react",
      "^react-native$": "<rootDir>/node_modules/react-native",
      "^@tanstack/react-query$": "<rootDir>/node_modules/@tanstack/react-query",
      "^msw/(.*)$": "<rootDir>/node_modules/msw/lib/$1/index.js",
      "^react-native-svg$": "<rootDir>/__mocks__/react-native-svg.js",
      "^react-native-svg/(.*)$": "<rootDir>/__mocks__/react-native-svg.js",
      "^expo-file-system/legacy$": "<rootDir>/__mocks__/expo-file-system-legacy.js"
    }
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@gluestack-ui/themed": "^1.1.0",
    "@nozbe/watermelondb": "^0.27.1",
    "@pilot/shared-api": "workspace:*",
    "@pilot/shared-types": "workspace:*",
    "@pilot/ui": "workspace:*",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/netinfo": "^11.4.1",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@tanstack/react-query": "^5.0.0",
    "aws-amplify": "^6.0.0",
    "expo": "~54.0.35",
    "expo-av": "^16.0.8",
    "expo-background-fetch": "^57.0.2",
    "expo-clipboard": "^57.0.1",
    "expo-constants": "~18.0.13",
    "expo-file-system": "~19.0.23",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-image-picker": "^17.0.11",
    "expo-linking": "~8.0.12",
    "expo-location": "^19.0.8",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-task-manager": "^57.0.2",
    "expo-web-browser": "~15.0.11",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-get-random-values": "^2.0.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-signature-canvas": "^5.1.1",
    "react-native-web": "~0.21.0",
    "react-native-webview": "^14.0.1",
    "react-native-worklets": "0.5.1",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.0",
    "@types/react": "~19.1.0",
    "babel-preset-expo": "^54.0.11",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "jest-expo": "^54.0.17",
    "msw": "^2.0.0",
    "react-test-renderer": "19.1.0",
    "typescript": "~5.9.2"
  },
  "private": true,
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
