# Root-level placeholder. All environment variables live in backend/.env
# (copy backend/.env.example to create it).
#
# The root docker-compose.yml uses backend/.env for all services:
# - postgres: Database credentials
# - celery_worker: All backend environment variables
# - celery_beat: All backend environment variables
#
# To configure environment variables:
# 1. Create backend/.env from backend/.env.example and edit it
# 2. Run: docker compose up -d
#
# See backend/.env.example for the complete list of available variables.
