# .infra-state.env.example — reference for fully-provisioned infrastructure (all phases complete)
# Actual .infra-state.env is GENERATED by generate-infra-state.sh and is gitignored.
#
# To generate the real file:
#   cd infrastructure/scripts
#   ./generate-infra-state.sh
#
# Flag meanings:
#   INFRA_NETWORKING  Phase 1: VPC, subnets, NAT Gateway, security groups, bastion EIP
#   INFRA_DATABASE    Phase 2: RDS PostgreSQL + ElastiCache Redis
#   INFRA_STORAGE     Phase 4+5: S3 buckets + CloudFront distribution
#   INFRA_BASTION     Phase 1: bastion EC2 instance (t3.micro)
#   INFRA_GPU         Phase 4: g4dn.xlarge GPU instance (pending AWS quota request)
#   INFRA_ECS         Phase 6: ECS cluster + pilot-api/worker/beat/web — all 4 services ACTIVE

# ── Provisioned resource IDs ──────────────────────────────────────────────────
GPU_INSTANCE_ID="i-0xxxxxxxxxxxxxxxxx"
BASTION_INSTANCE_ID="i-0xxxxxxxxxxxxxxxxx"
CLOUDFRONT_DIST_ID="XXXXXXXXXXXXX"
ECS_CLUSTER="pilot-production"

# ── Feature flags (all true = all phases complete) ───────────────────────────
INFRA_NETWORKING="true"
INFRA_DATABASE="true"
INFRA_STORAGE="true"
INFRA_BASTION="true"
INFRA_GPU="true"
INFRA_ECS="true"
